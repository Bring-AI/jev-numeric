# Choose one gateway. Never commit your actual .env.
JEV_GATEWAY=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13-20260917
# Or use JEV_GATEWAY=typesafe:
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# Optional instead of an inline key (path resolved from your current directory):
# OPENROUTER_API_KEY_FILE=/absolute/path/to/key
# TYPESAFE_API_KEY_FILE=/absolute/path/to/key
